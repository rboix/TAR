<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="tar_lab">

    <!-- Los plugins gazebo_ros_* (factory, init, state) los carga gazebo.launch.py
         como plugins de sistema via "-s" — NO se incluyen aquí (darían error
         "incorrect plugin type"). -->

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-4 -4 4 0 0.5 0.785</pose>
      </camera>
    </gui>

    <!-- Luz solar -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Suelo local (no descarga modelos online, así no se cuelga sin internet) -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- ===== Paredes (5x5 m) ===== -->
    <model name="wall_n">
      <static>true</static>
      <pose>0 2.5 0.75 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>5 0.1 1.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5 0.1 1.5</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -2.5 0.75 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>5 0.1 1.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5 0.1 1.5</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>2.5 0 0.75 0 0 1.5708</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>5 0.1 1.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5 0.1 1.5</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-2.5 0 0.75 0 0 1.5708</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>5 0.1 1.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5 0.1 1.5</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- ===== Mesa baja al frente (40cm de alto — adaptada al FOV del TB3) ===== -->
    <model name="table">
      <static>true</static>
      <pose>1.5 0 0 0 0 0</pose>
      <link name="top">
        <pose>0 0 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.8 0.6 0.05</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 0.6 0.05</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Wood</name>
          </script></material>
        </visual>
      </link>
      <link name="legs">
        <collision name="lf"><pose> 0.35  0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry></collision>
        <collision name="rf"><pose> 0.35 -0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry></collision>
        <collision name="lb"><pose>-0.35  0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry></collision>
        <collision name="rb"><pose>-0.35 -0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry></collision>
        <visual name="vlf"><pose> 0.35  0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <visual name="vrf"><pose> 0.35 -0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <visual name="vlb"><pose>-0.35  0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <visual name="vrb"><pose>-0.35 -0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>

    <!-- ===== Botella verde encima de la mesa ===== -->
    <model name="bottle">
      <pose>1.5 0.15 0.53 0 0 0</pose>
      <link name="l">
        <inertial><mass>0.3</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.0005</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Green</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- ===== Silla a la derecha ===== -->
    <model name="chair">
      <static>true</static>
      <pose>1.0 -1.5 0 0 0 1.5708</pose>
      <link name="seat">
        <pose>0 0 0.45 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.45 0.45 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.45 0.45 0.05</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
      </link>
      <link name="back">
        <pose>-0.2 0 0.75 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.45 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.45 0.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
      </link>
      <link name="legs">
        <collision name="lf"><pose> 0.2  0.2 0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.45</size></box></geometry></collision>
        <collision name="rf"><pose> 0.2 -0.2 0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.45</size></box></geometry></collision>
        <collision name="lb"><pose>-0.2  0.2 0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.45</size></box></geometry></collision>
        <collision name="rb"><pose>-0.2 -0.2 0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.45</size></box></geometry></collision>
        <visual name="vlf"><pose> 0.2  0.2 0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.45</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
        <visual name="vrf"><pose> 0.2 -0.2 0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.45</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
        <visual name="vlb"><pose>-0.2  0.2 0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.45</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
        <visual name="vrb"><pose>-0.2 -0.2 0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.45</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
      </link>
    </model>

    <!-- ===========================================================
         OBJETOS ENCIMA DE LA MESA (top z ≈ 0.825)
         =========================================================== -->

    <!-- Portátil abierto (base + pantalla inclinada) -->
    <model name="laptop">
      <static>true</static>
      <pose>1.4 -0.18 0.435 0 0 -0.4</pose>
      <link name="base">
        <collision name="c"><geometry><box><size>0.30 0.22 0.02</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.30 0.22 0.02</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse>
                    <specular>0.5 0.5 0.5 1</specular></material>
        </visual>
      </link>
      <link name="screen">
        <pose>-0.13 0 0.11 0 -1.3 0</pose>
        <collision name="c"><geometry><box><size>0.20 0.22 0.01</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.20 0.22 0.01</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material>
        </visual>
      </link>
      <link name="display">
        <pose>-0.13 0 0.11 0 -1.3 0</pose>
        <visual name="v">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>0.185 0.205 0.001</size></box></geometry>
          <material><ambient>0.05 0.20 0.45 1</ambient><diffuse>0.10 0.40 0.85 1</diffuse>
                    <emissive>0.05 0.15 0.30 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Libro encima de la mesa (rojo) -->
    <model name="book">
      <static>true</static>
      <pose>1.6 0.30 0.440 0 0 0.3</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.22 0.15 0.03</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.22 0.15 0.03</size></box></geometry>
          <material><ambient>0.55 0.10 0.10 1</ambient><diffuse>0.75 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Vaso con agua (vaso transparente azulado + nivel de agua interior) -->
    <model name="water_glass">
      <pose>1.7 -0.05 0.480 0 0 0</pose>
      <link name="glass">
        <inertial><mass>0.15</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.035</radius><length>0.11</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.035</radius><length>0.11</length></cylinder></geometry>
          <material><ambient>0.75 0.85 0.95 0.35</ambient><diffuse>0.85 0.95 1.00 0.35</diffuse>
                    <specular>0.9 0.9 1.0 1</specular></material>
        </visual>
        <visual name="water">
          <pose>0 0 -0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.032</radius><length>0.07</length></cylinder></geometry>
          <material><ambient>0.10 0.35 0.65 1</ambient><diffuse>0.15 0.50 0.85 1</diffuse>
                    <specular>0.3 0.5 0.8 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Lápiz amarillo con punta -->
    <model name="pencil">
      <pose>1.45 0.10 0.432 0 1.5708 0.6</pose>
      <link name="body">
        <inertial><mass>0.01</mass>
          <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-7</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.005</radius><length>0.16</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.005</radius><length>0.16</length></cylinder></geometry>
          <material><ambient>0.90 0.75 0.10 1</ambient><diffuse>1.00 0.85 0.15 1</diffuse></material>
        </visual>
        <visual name="tip">
          <pose>0 0 0.085 0 0 0</pose>
          <geometry><cylinder><radius>0.005</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="eraser">
          <pose>0 0 -0.083 0 0 0</pose>
          <geometry><cylinder><radius>0.0055</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.65 0.20 0.20 1</ambient><diffuse>0.85 0.30 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Taza de café (cilindro + asa) -->
    <model name="mug">
      <pose>1.30 0.20 0.470 0 0 0</pose>
      <link name="body">
        <inertial><mass>0.25</mass>
          <inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0002</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.09</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.04</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
        <visual name="handle">
          <pose>0.045 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
        <visual name="coffee">
          <pose>0 0 0.035 0 0 0</pose>
          <geometry><cylinder><radius>0.037</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.20 0.10 0.05 1</ambient><diffuse>0.30 0.15 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===========================================================
         OBJETOS EN EL SUELO
         =========================================================== -->

    <!-- Mochila (cuerpo + bolsillo frontal + asas) -->
    <model name="backpack">
      <pose>0.5 1.5 0.22 0 0 -0.5</pose>
      <link name="body">
        <inertial><mass>1.5</mass>
          <inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.02</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.32 0.18 0.44</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.32 0.18 0.44</size></box></geometry>
          <material><ambient>0.20 0.25 0.45 1</ambient><diffuse>0.25 0.35 0.65 1</diffuse></material>
        </visual>
        <visual name="front_pocket">
          <pose>0 -0.10 -0.08 0 0 0</pose>
          <geometry><box><size>0.22 0.04 0.18</size></box></geometry>
          <material><ambient>0.15 0.20 0.40 1</ambient><diffuse>0.20 0.30 0.55 1</diffuse></material>
        </visual>
        <visual name="strap_l">
          <pose>-0.10 0.10 0.10 0.3 0 0</pose>
          <geometry><box><size>0.04 0.03 0.30</size></box></geometry>
          <material><ambient>0.10 0.15 0.30 1</ambient><diffuse>0.15 0.20 0.40 1</diffuse></material>
        </visual>
        <visual name="strap_r">
          <pose> 0.10 0.10 0.10 0.3 0 0</pose>
          <geometry><box><size>0.04 0.03 0.30</size></box></geometry>
          <material><ambient>0.10 0.15 0.30 1</ambient><diffuse>0.15 0.20 0.40 1</diffuse></material>
        </visual>
        <visual name="handle">
          <pose>0 0 0.24 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.10 0.15 0.30 1</ambient><diffuse>0.15 0.20 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Caja de cartón con material (con solapas abiertas) -->
    <model name="cardboard_box">
      <pose>-1.2 1.4 0.15 0 0 0.3</pose>
      <link name="body">
        <inertial><mass>0.8</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.35 0.28 0.30</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.35 0.28 0.30</size></box></geometry>
          <material><ambient>0.50 0.36 0.18 1</ambient><diffuse>0.65 0.46 0.22 1</diffuse></material>
        </visual>
        <visual name="flap_front">
          <pose>0 -0.14 0.13 -0.6 0 0</pose>
          <geometry><box><size>0.34 0.14 0.005</size></box></geometry>
          <material><ambient>0.45 0.32 0.16 1</ambient><diffuse>0.60 0.42 0.20 1</diffuse></material>
        </visual>
        <visual name="flap_back">
          <pose>0  0.14 0.13  0.6 0 0</pose>
          <geometry><box><size>0.34 0.14 0.005</size></box></geometry>
          <material><ambient>0.45 0.32 0.16 1</ambient><diffuse>0.60 0.42 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pila de libros en el suelo (3 tomos) -->
    <model name="book_stack">
      <pose>-1.4 0.6 0 0 0 0.15</pose>
      <link name="book_bottom">
        <pose>0 0 0.018 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.25 0.18 0.035</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 0.18 0.035</size></box></geometry>
          <material><ambient>0.10 0.30 0.20 1</ambient><diffuse>0.15 0.50 0.30 1</diffuse></material></visual>
      </link>
      <link name="book_middle">
        <pose>0.01 -0.005 0.058 0 0 -0.05</pose>
        <collision name="c"><geometry><box><size>0.23 0.17 0.028</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.23 0.17 0.028</size></box></geometry>
          <material><ambient>0.40 0.30 0.10 1</ambient><diffuse>0.65 0.50 0.18 1</diffuse></material></visual>
      </link>
      <link name="book_top">
        <pose>-0.005 0.010 0.090 0 0 0.08</pose>
        <collision name="c"><geometry><box><size>0.24 0.16 0.030</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.24 0.16 0.030</size></box></geometry>
          <material><ambient>0.20 0.10 0.30 1</ambient><diffuse>0.30 0.15 0.50 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Carpeta archivadora (folder) en el suelo -->
    <model name="folder">
      <pose>-0.9 -0.2 0.02 0 0 1.2</pose>
      <link name="l">
        <inertial><mass>0.3</mass>
          <inertia><ixx>0.001</ixx><iyy>0.002</iyy><izz>0.003</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.32 0.24 0.035</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.32 0.24 0.035</size></box></geometry>
          <material><ambient>0.45 0.15 0.10 1</ambient><diffuse>0.65 0.20 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pelota azul (mantenida del mundo anterior) -->
    <model name="blue_ball">
      <pose>-1.5 -1.0 0.15 0 0 0</pose>
      <link name="l">
        <inertial><mass>0.2</mass>
          <inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.15</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Blue</name>
          </script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
