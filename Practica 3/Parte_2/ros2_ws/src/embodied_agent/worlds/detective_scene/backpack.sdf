<?xml version="1.0"?>
<!-- Mochila abierta — cuerpo azul + bolsillo frontal + asa.
     Spawnea con el centro a z≈0.22 para que toque el suelo. -->
<sdf version="1.8">
  <model name="backpack">
    <static>true</static>
    <link name="body">
      <collision name="c">
        <geometry><box><size>0.32 0.18 0.44</size></box></geometry>
      </collision>
      <visual name="body_v">
        <geometry><box><size>0.32 0.18 0.44</size></box></geometry>
        <material>
          <ambient>0.18 0.22 0.42 1</ambient>
          <diffuse>0.25 0.32 0.62 1</diffuse>
        </material>
      </visual>
      <visual name="front_pocket">
        <pose>0 -0.10 -0.08 0 0 0</pose>
        <geometry><box><size>0.22 0.04 0.18</size></box></geometry>
        <material>
          <ambient>0.13 0.18 0.38 1</ambient>
          <diffuse>0.18 0.25 0.52 1</diffuse>
        </material>
      </visual>
      <visual name="open_flap">
        <pose>0 0 0.20 0.4 0 0</pose>
        <geometry><box><size>0.30 0.16 0.02</size></box></geometry>
        <material>
          <ambient>0.13 0.18 0.38 1</ambient>
          <diffuse>0.18 0.25 0.52 1</diffuse>
        </material>
      </visual>
      <visual name="handle">
        <pose>0 0 0.24 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry>
        <material>
          <ambient>0.08 0.12 0.28 1</ambient>
          <diffuse>0.12 0.18 0.38 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
