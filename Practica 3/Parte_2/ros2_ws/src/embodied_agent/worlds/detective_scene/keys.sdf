<?xml version="1.0"?>
<!-- Llavero tendido en el suelo: anilla dorada + 2 llaves + llavero rojo.
     Centro del modelo a z≈0.003 (grosor total 0.005 m). -->
<sdf version="1.8">
  <model name="keys">
    <static>true</static>
    <link name="link">
      <collision name="c">
        <geometry><box><size>0.13 0.07 0.005</size></box></geometry>
      </collision>

      <!-- Anilla del llavero (dorada) -->
      <visual name="ring">
        <pose>-0.042 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.014</radius><length>0.004</length></cylinder></geometry>
        <material>
          <ambient>0.62 0.57 0.18 1</ambient>
          <diffuse>0.85 0.76 0.28 1</diffuse>
          <specular>0.85 0.80 0.45 1</specular>
        </material>
      </visual>

      <!-- Llave 1 — eje largo (dorada) -->
      <visual name="key1_shaft">
        <pose>0.018 0.007 0 0 0 0.18</pose>
        <geometry><box><size>0.062 0.007 0.004</size></box></geometry>
        <material>
          <ambient>0.58 0.53 0.16 1</ambient>
          <diffuse>0.80 0.70 0.24 1</diffuse>
          <specular>0.85 0.80 0.45 1</specular>
        </material>
      </visual>
      <visual name="key1_head">
        <pose>-0.013 0.007 0 0 0 0.18</pose>
        <geometry><box><size>0.016 0.014 0.004</size></box></geometry>
        <material>
          <ambient>0.58 0.53 0.16 1</ambient>
          <diffuse>0.80 0.70 0.24 1</diffuse>
          <specular>0.85 0.80 0.45 1</specular>
        </material>
      </visual>
      <!-- Dientes de la llave 1 (3 muescas) -->
      <visual name="key1_tooth1">
        <pose>0.030 0.004 0 0 0 0.18</pose>
        <geometry><box><size>0.006 0.004 0.004</size></box></geometry>
        <material><ambient>0.50 0.45 0.12 1</ambient><diffuse>0.70 0.60 0.20 1</diffuse></material>
      </visual>
      <visual name="key1_tooth2">
        <pose>0.018 0.004 0 0 0 0.18</pose>
        <geometry><box><size>0.006 0.006 0.004</size></box></geometry>
        <material><ambient>0.50 0.45 0.12 1</ambient><diffuse>0.70 0.60 0.20 1</diffuse></material>
      </visual>

      <!-- Llave 2 — más corta (plateada) -->
      <visual name="key2_shaft">
        <pose>0.012 -0.010 0 0 0 -0.22</pose>
        <geometry><box><size>0.050 0.007 0.004</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.52 1</ambient>
          <diffuse>0.70 0.70 0.72 1</diffuse>
          <specular>0.90 0.90 0.90 1</specular>
        </material>
      </visual>
      <visual name="key2_head">
        <pose>-0.012 -0.010 0 0 0 -0.22</pose>
        <geometry><box><size>0.015 0.013 0.004</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.52 1</ambient>
          <diffuse>0.70 0.70 0.72 1</diffuse>
          <specular>0.90 0.90 0.90 1</specular>
        </material>
      </visual>

      <!-- Llavero de identificación (tag rojo) -->
      <visual name="tag">
        <pose>-0.057 0 0 0 0 0</pose>
        <geometry><box><size>0.018 0.011 0.004</size></box></geometry>
        <material>
          <ambient>0.62 0.06 0.06 1</ambient>
          <diffuse>0.85 0.10 0.10 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
