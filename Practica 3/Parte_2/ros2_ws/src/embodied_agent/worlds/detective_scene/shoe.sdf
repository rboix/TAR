<?xml version="1.0"?>
<!-- Zapatilla — caja elongada + "punta" (la suela tendida en el suelo). -->
<sdf version="1.8">
  <model name="shoe">
    <static>true</static>
    <link name="link">
      <collision name="c">
        <geometry><box><size>0.27 0.10 0.10</size></box></geometry>
      </collision>
      <visual name="sole">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><box><size>0.27 0.10 0.02</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <visual name="upper">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><box><size>0.25 0.09 0.08</size></box></geometry>
        <material>
          <ambient>0.55 0.10 0.10 1</ambient>
          <diffuse>0.78 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="laces">
        <pose>0.02 0 0.055 0 0 0</pose>
        <geometry><box><size>0.10 0.04 0.005</size></box></geometry>
        <material>
          <ambient>0.92 0.92 0.92 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
